# =====================================================================
# Copia este archivo como ".env.local" (para tu computadora) y llena los
# valores. En Vercel se capturan en Settings → Environment Variables.
# NUNCA subas .env.local a GitHub (ya está en .gitignore).
# =====================================================================

# --- Supabase (Project Settings → API Keys / Data API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# "Publishable key" (sb_publishable_...) o la "anon key" antigua
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "Secret key" (sb_secret_...) o la "service_role key" antigua. SOLO servidor.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (console.anthropic.com → API Keys) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Resend (resend.com → API Keys) ---
RESEND_API_KEY=
# Sin dominio propio usa: Asesor Financiero <onboarding@resend.dev>
# (solo puede enviar al correo con el que te registraste en Resend)
ALERT_EMAIL_FROM=Asesor Financiero <onboarding@resend.dev>

# --- Tu cuenta ---
ALLOWED_EMAIL=leoromsol498@gmail.com
NEXT_PUBLIC_APP_CURRENCY=MXN
NEXT_PUBLIC_APP_TIMEZONE=America/Mexico_City

# --- Crons ---
# Texto aleatorio largo. Genera uno con:  openssl rand -hex 32
CRON_SECRET=

# Dirección pública de la app (para los botones de los correos)
NEXT_PUBLIC_APP_URL=http://localhost:3000
